{
  "id": "B49",
  "name": "Zigbee temperature and battery decoder",
  "description": "Port of temperature and percentage scaling only; metadata override supplied explicitly. No arbitrary device model detection, voltage estimation or Zigbee transport.",
  "version": "0.1.0",
  "date": "2026-11-11",
  "tier": "general",
  "source_url": "https://github.com/Koenkk/zigbee-herdsman-converters/blob/master/src/converters/fromZigbee.ts",
  "upstream_commit_or_version": "f46c6d88f0eaceaf25dca7dba0dda797d2dc281e",
  "license": "MIT",
  "distribution": "public-ok",
  "attribution": [
    "Koenkk/zigbee-herdsman-converters",
    "Original copyright and notices preserved in LICENSE, NOTICE and upstream/"
  ],
  "inputs": {
    "type": "object",
    "properties": {
      "measuredValue": {
        "type": "number"
      },
      "batteryPercentageRemaining": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "dontDividePercentage": {
        "type": "boolean"
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "outputs": {
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "ok": {
            "const": true
          },
          "result": {
            "type": "object",
            "properties": {
              "battery_percent": {
                "type": "number"
              },
              "temperature_C": {
                "type": "number"
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "required": [
          "ok",
          "result"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "ok": {
            "const": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "maxLength": 100000
              },
              "message": {
                "type": "string",
                "maxLength": 100000
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "ok",
          "error"
        ],
        "additionalProperties": false
      }
    ]
  },
  "budget": {
    "max_input_bytes": 1048576,
    "timeout_seconds": 10,
    "max_array_items": 10000,
    "enforcement": "CLI input byte bound and JSON Schema array/string bounds enforced. Runtime timeout is enforced for subprocess tools only; other tools require an external 10-second watchdog. No general memory sandbox claimed."
  },
  "signature": null,
  "revocation_url": null,
  "teaching_path": [
    "Inspect SOURCE.md and license evidence",
    "Call the deterministic JSON tool",
    "Review tests and explain the returned result; never invent missing values"
  ],
  "status": "built",
  "skip_reason": null,
  "implementation_kind": "ported-core",
  "tool": "tool/main.py",
  "dependencies": {
    "python": ">=3.11",
    "shared_runtime": "../_vendor",
    "node": ">=20 for JS-backed tools"
  },
  "mcp": {
    "transport": "stdio",
    "command": "python3",
    "tool_name": "skillpack_b49",
    "server_path": "mcp/server.py"
  }
}
