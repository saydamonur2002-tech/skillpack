{
  "id": "A6",
  "name": "Adapt fixed-vocabulary intent requirements",
  "description": "Uses pinned adapt-parser 1.0.0 runtime. Fixed input vocabulary, no regex registrations, no actions. Confidence is upstream scoring, not a calibrated probability.",
  "version": "0.1.0",
  "date": "2026-11-11",
  "tier": "revival",
  "source_url": "https://github.com/MycroftAI/adapt",
  "upstream_commit_or_version": "06b98f8d5e525601a763103ad572b8ae615655a5",
  "license": "Apache-2.0",
  "distribution": "public-ok",
  "attribution": [
    "MycroftAI/adapt",
    "Original copyright and notices preserved in LICENSE, NOTICE and upstream/"
  ],
  "inputs": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "maxLength": 100000
      },
      "vocabulary": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100000
          },
          "minItems": 0,
          "maxItems": 10000
        }
      },
      "required": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 100000
        },
        "minItems": 1,
        "maxItems": 10000
      }
    },
    "required": [
      "text",
      "vocabulary",
      "required"
    ],
    "additionalProperties": false
  },
  "outputs": {
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "ok": {
            "const": true
          },
          "result": {
            "type": "object",
            "properties": {
              "matches": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            },
            "required": [
              "matches"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "ok",
          "result"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "ok": {
            "const": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "maxLength": 100000
              },
              "message": {
                "type": "string",
                "maxLength": 100000
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "ok",
          "error"
        ],
        "additionalProperties": false
      }
    ]
  },
  "budget": {
    "max_input_bytes": 1048576,
    "timeout_seconds": 10,
    "max_array_items": 10000,
    "enforcement": "CLI input byte bound and JSON Schema array/string bounds enforced. Runtime timeout is enforced for subprocess tools only; other tools require an external 10-second watchdog. No general memory sandbox claimed."
  },
  "signature": null,
  "revocation_url": null,
  "teaching_path": [
    "Inspect SOURCE.md and license evidence",
    "Call the deterministic JSON tool",
    "Review tests and explain the returned result; never invent missing values"
  ],
  "status": "built",
  "skip_reason": null,
  "implementation_kind": "runtime-adapter",
  "tool": "tool/main.py",
  "dependencies": {
    "python": ">=3.11",
    "shared_runtime": "../_vendor",
    "node": ">=20 for JS-backed tools",
    "adapt-parser": "1.0.0"
  },
  "mcp": {
    "transport": "stdio",
    "command": "python3",
    "tool_name": "skillpack_a6",
    "server_path": "mcp/server.py"
  }
}
