{
  "id": "B44",
  "name": "Home Assistant temperature converter",
  "description": "C/F/K only; absolute and delta distinguished, below-absolute-zero inputs additionally rejected. No whole Home Assistant runtime.",
  "version": "0.1.0",
  "date": "2026-11-11",
  "tier": "general",
  "source_url": "https://github.com/home-assistant/core/blob/dev/homeassistant/util/unit_conversion.py",
  "upstream_commit_or_version": "d9115f3e0492aa94b06edb439ab1ebcd594b4738",
  "license": "Apache-2.0",
  "distribution": "public-ok",
  "attribution": [
    "home-assistant/core",
    "Original copyright and notices preserved in LICENSE, NOTICE and upstream/"
  ],
  "inputs": {
    "type": "object",
    "properties": {
      "value": {
        "type": "number"
      },
      "from": {
        "enum": [
          "C",
          "F",
          "K"
        ]
      },
      "to": {
        "enum": [
          "C",
          "F",
          "K"
        ]
      },
      "is_delta": {
        "type": "boolean"
      }
    },
    "required": [
      "value",
      "from",
      "to"
    ],
    "additionalProperties": false
  },
  "outputs": {
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "ok": {
            "const": true
          },
          "result": {
            "type": "object",
            "properties": {
              "is_delta": {
                "type": "boolean"
              },
              "unit": {
                "type": "string"
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
              "is_delta",
              "unit",
              "value"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "ok",
          "result"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "ok": {
            "const": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "maxLength": 100000
              },
              "message": {
                "type": "string",
                "maxLength": 100000
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "ok",
          "error"
        ],
        "additionalProperties": false
      }
    ]
  },
  "budget": {
    "max_input_bytes": 1048576,
    "timeout_seconds": 10,
    "max_array_items": 10000,
    "enforcement": "CLI input byte bound and JSON Schema array/string bounds enforced. Runtime timeout is enforced for subprocess tools only; other tools require an external 10-second watchdog. No general memory sandbox claimed."
  },
  "signature": null,
  "revocation_url": null,
  "teaching_path": [
    "Inspect SOURCE.md and license evidence",
    "Call the deterministic JSON tool",
    "Review tests and explain the returned result; never invent missing values"
  ],
  "status": "built",
  "skip_reason": null,
  "implementation_kind": "ported-core",
  "tool": "tool/main.py",
  "dependencies": {
    "python": ">=3.11",
    "shared_runtime": "../_vendor",
    "node": ">=20 for JS-backed tools"
  },
  "mcp": {
    "transport": "stdio",
    "command": "python3",
    "tool_name": "skillpack_b44",
    "server_path": "mcp/server.py"
  }
}
