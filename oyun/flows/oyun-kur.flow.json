     "path": "result.road_connected",
     "op": "==",
     "value": true,
     "why_tr": "Bütün yollar birbirine bağlı olmalı."
    },
    {
     "path": "result.counts.B",
     "op": ">=",
     "value": 50,
     "why_tr": "Şehirde yeterince bina olmalı."
    }
   ],
   "stop_and_ask_tr": "Harita bağlı değil ya da çok boşsa: kullanıcıya başka bir tohum (seed) ya da boyut öner, ustaya sor."
