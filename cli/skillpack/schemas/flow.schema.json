{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/saydamonur2002-tech/skillpack/schemas/flow.schema.json",
  "title": "flow.yaml (akış profili v0.1)",
  "type": "object",
  "required": ["flow", "inputs", "steps", "outcomes", "on_unknown"],
  "additionalProperties": false,
  "$defs": {
    "ident": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 48},
    "scalar": {"type": ["number", "string", "boolean"]}
  },
  "properties": {
    "flow": {"const": "0.1"},
    "params": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/ident"},
      "additionalProperties": {"$ref": "#/$defs/scalar"}
    },
    "inputs": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/ident"},
      "additionalProperties": {
        "type": "object",
        "required": ["type", "prompt"],
        "additionalProperties": false,
        "properties": {
          "type": {"enum": ["number", "integer", "bool", "choice"]},
          "prompt": {"type": "string", "minLength": 1},
          "hint": {"type": "string"},
          "unit": {"type": "string"},
          "min": {"type": "number"},
          "max": {"type": "number"},
          "choices": {"type": "array", "items": {"$ref": "#/$defs/ident"}, "minItems": 2},
          "sensor": {"type": "string"}
        }
      }
    },
    "tables": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/ident"},
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "required": ["type", "rows"],
            "additionalProperties": false,
            "properties": {
              "type": {"const": "map"},
              "rows": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/scalar"}}
            }
          },
          {
            "type": "object",
            "required": ["type", "rows"],
            "additionalProperties": false,
            "properties": {
              "type": {"const": "range"},
              "rows": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": ["value"],
                  "additionalProperties": false,
                  "properties": {"below": {"type": "number"}, "value": {"$ref": "#/$defs/scalar"}}
                }
              }
            }
          }
        ]
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/$defs/ident"},
          "ask": {"$ref": "#/$defs/ident"},
          "compute": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {"$ref": "#/$defs/ident"},
            "additionalProperties": {"type": "string"}
          },
          "lookup": {
            "type": "object",
            "required": ["table", "key", "into"],
            "additionalProperties": false,
            "properties": {
              "table": {"$ref": "#/$defs/ident"},
              "key": {"type": "string"},
              "into": {"$ref": "#/$defs/ident"}
            }
          },
          "decide": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "when": {"type": "string"},
                "else": {"const": true},
                "goto": {"$ref": "#/$defs/ident"},
                "finish": {"$ref": "#/$defs/ident"},
                "continue": {"const": true}
              }
            }
          },
          "say": {"type": "string", "minLength": 1},
          "act": {
            "type": "object",
            "required": ["action", "text"],
            "additionalProperties": false,
            "properties": {
              "action": {"type": "string", "pattern": "^[a-z_]+$"},
              "text": {"type": "string", "minLength": 1}
            }
          },
          "finish": {"$ref": "#/$defs/ident"}
        }
      }
    },
    "outcomes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/ident"},
      "additionalProperties": {
        "type": "object",
        "required": ["verdict", "message"],
        "additionalProperties": false,
        "properties": {
          "verdict": {"enum": ["ok", "warn", "stop", "escalate"]},
          "message": {"type": "string", "minLength": 1}
        }
      }
    },
    "on_unknown": {"$ref": "#/$defs/ident"}
  }
}
