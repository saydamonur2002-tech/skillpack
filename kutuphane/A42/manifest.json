{
  "id": "A42",
  "name": "lit-fhir R4 Patient scalar structural subset",
  "description": "New structural port of selected Patient scalar fields. Not full FHIR R4, date calendar validity, profiles, terminology or clinical validation. Synthetic inputs only.",
  "version": "0.1.0",
  "date": "2026-11-11",
  "tier": "revival",
  "source_url": "https://github.com/babylonhealth/lit-fhir",
  "upstream_commit_or_version": "9791e0aef2552507f465e6326ed60e66a277f1f9",
  "license": "Apache-2.0",
  "distribution": "public-ok",
  "attribution": [
    "babylonhealth/lit-fhir",
    "Original copyright and notices preserved in LICENSE, NOTICE and upstream/"
  ],
  "inputs": {
    "type": "object",
    "properties": {
      "resource": {
        "type": "object"
      }
    },
    "required": [
      "resource"
    ],
    "additionalProperties": false
  },
  "outputs": {
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "ok": {
            "const": true
          },
          "result": {
            "type": "object",
            "properties": {
              "resource": {
                "type": "object"
              },
              "scope": {
                "type": "string"
              }
            },
            "required": [
              "resource",
              "scope"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "ok",
          "result"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "ok": {
            "const": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "maxLength": 100000
              },
              "message": {
                "type": "string",
                "maxLength": 100000
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "ok",
          "error"
        ],
        "additionalProperties": false
      }
    ]
  },
  "budget": {
    "max_input_bytes": 1048576,
    "timeout_seconds": 10,
    "max_array_items": 10000,
    "enforcement": "CLI input byte bound and JSON Schema array/string bounds enforced. Runtime timeout is enforced for subprocess tools only; other tools require an external 10-second watchdog. No general memory sandbox claimed."
  },
  "signature": null,
  "revocation_url": null,
  "teaching_path": [
    "Inspect SOURCE.md and license evidence",
    "Call the deterministic JSON tool",
    "Review tests and explain the returned result; never invent missing values"
  ],
  "status": "built",
  "skip_reason": null,
  "implementation_kind": "schema-rule",
  "tool": "tool/main.py",
  "dependencies": {
    "python": ">=3.11",
    "shared_runtime": "../_vendor",
    "node": ">=20 for JS-backed tools"
  },
  "mcp": {
    "transport": "stdio",
    "command": "python3",
    "tool_name": "skillpack_a42",
    "server_path": "mcp/server.py"
  }
}
