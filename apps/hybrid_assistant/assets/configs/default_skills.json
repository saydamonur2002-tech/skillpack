{
  "schema_version": "1.0",
  "pack_id": "hybrid-assistant.demo",
  "version": "1.0.0",
  "updated_at": "2026-11-10T00:00:00Z",
  "budget": {
    "cloud_max_tokens_per_day": 0,
    "on_exceed": "ask_user"
  },
  "rules": [
    {
      "id": "thermal-severe",
      "priority": 1,
      "description": "Android 10+ sistem ısı durumu ciddi ve üzeri.",
      "when": {
        "all": [
          {"field": "thermal_supported", "op": "eq", "value": true},
          {"field": "thermal_status", "op": "gte", "value": 3}
        ]
      },
      "then": {
        "action": "answer_local",
        "message": "Sistem ısınıyor. Şarjı ve kılıfı çıkarın.",
        "allow_cloud": false,
        "settings": ["battery_saver", "display"]
      }
    },
    {
      "id": "battery-temp-high",
      "priority": 2,
      "description": "Isı durumu yoksa pil sıcaklığına bak.",
      "when": {
        "all": [
          {"field": "thermal_supported", "op": "eq", "value": false},
          {"field": "battery_temp_c", "op": "gte", "value": 40}
        ]
      },
      "then": {
        "action": "answer_local",
        "message": "Pil sıcak. Şarjı ve kılıfı çıkarın.",
        "allow_cloud": false,
        "settings": ["battery_saver", "display"]
      }
    },
    {
      "id": "charge-overheat",
      "priority": 3,
      "description": "Sistem aşırı ısınma kodu veya şarjdayken yüksek pil sıcaklığı.",
      "when": {
        "any": [
          {"field": "health", "op": "eq", "value": "overheat"},
          {
            "all": [
              {"field": "is_plugged", "op": "eq", "value": true},
              {"field": "battery_temp_c", "op": "gte", "value": 40}
            ]
          }
        ]
      },
      "then": {
        "action": "answer_local",
        "message": "Şarjı çıkarın; pil ısınıyor.",
        "allow_cloud": false,
        "settings": ["display"]
      }
    },
    {
      "id": "battery-low",
      "priority": 4,
      "description": "Pil yüzde 20 altında ve şarj olmuyor.",
      "when": {
        "all": [
          {"field": "battery_level", "op": "lt", "value": 20},
          {"field": "is_charging", "op": "eq", "value": false}
        ]
      },
      "then": {
        "action": "answer_local",
        "message": "Pil düşük. Güç tasarrufunu Ayarlar'dan açabilirsiniz.",
        "allow_cloud": false,
        "settings": ["battery_saver"]
      }
    },
    {
      "id": "low-memory",
      "priority": 5,
      "description": "Sistem düşük bellek bildiriyor.",
      "when": {"field": "low_memory", "op": "eq", "value": true},
      "then": {
        "action": "answer_local",
        "message": "Sistem bellek baskısı bildiriyor; ağır iş durdu.",
        "allow_cloud": false
      }
    },
    {
      "id": "storage-low",
      "priority": 6,
      "description": "Boş depolama 1 GB altında.",
      "when": {"field": "available_bytes", "op": "lt", "value": 1000000000},
      "then": {
        "action": "answer_local",
        "message": "Depolama azaldı. Depolama ayarını açabilirsiniz.",
        "allow_cloud": false,
        "settings": ["storage"]
      }
    },
    {
      "id": "greet",
      "priority": 10,
      "description": "Simple greeting handled fully offline.",
      "when": {
        "field": "intent",
        "op": "eq",
        "value": "greet"
      },
      "then": {
        "action": "answer_local",
        "message": "Merhaba. Karar yerel kurallarda; açıklama gerekirse buluta sorulur.",
        "allow_cloud": false
      }
    },
    {
      "id": "explain-need",
      "priority": 20,
      "description": "Needs an explanation; may ask cloud after user budget consent.",
      "when": {
        "field": "intent",
        "op": "eq",
        "value": "explain"
      },
      "then": {
        "action": "ask_cloud_explain",
        "message": "Yerel kural eşleşti; açıklama için bulut modeli kullanılabilir.",
        "allow_cloud": true
      }
    },
    {
      "id": "unknown",
      "priority": 1000,
      "description": "Catch-all local fallback.",
      "when": {
        "field": "query",
        "op": "contains",
        "value": ""
      },
      "then": {
        "action": "fallback",
        "message": "Eşleşen kural yok. Çevrimdışı yedek yanıt kullanılıyor.",
        "allow_cloud": false
      }
    }
  ]
}
