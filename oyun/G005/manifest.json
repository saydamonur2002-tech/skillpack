  "inputs": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "operation",
      "grid",
      "queries"
    ],
    "properties": {
      "operation": {
        "enum": [
          "find_path"
        ]
      },
      "grid": {
        "type": "array",
        "minItems": 1,
        "maxItems": 128,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[!-~]+$"
        }
      },
      "costs": {
        "type": "object",
        "minProperties": 1,
        "maxProperties": 32,
        "propertyNames": {
          "pattern": "^[!-~]$"
        },
        "additionalProperties": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "diagonal": {
        "enum": [
          "never",
          "always",
          "if_at_most_one_obstacle",
          "only_when_no_obstacle"
        ]
      },
      "heuristic_weight": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10
      },
      "max_runs": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000000
      },
      "queries": {
        "type": "array",
        "minItems": 1,
        "maxItems": 64,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 127
              }
            },
            "end": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 127
              }
            }
          }
        }
      }
    }
  },
  "outputs": {
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "ok": {
            "const": true
          },
          "result": {
            "type": "object"
          }
        },
        "required": [
          "ok",
          "result"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "ok": {
            "const": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "ok",
          "error"
        ],
        "additionalProperties": false
      }
    ]
  },
  "budget": {
    "max_input_bytes": 65536,
    "timeout_seconds": 10,
    "enforcement": "Raw CLI byte limit and POSIX alarm; strict schema, finite values and nesting checks; MCP subprocess killed/reaped after the timeout. One active calculation. Not a hostile-code sandbox."
  },
