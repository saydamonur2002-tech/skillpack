{
 "format": "skillpack-flow-1",
 "name": "oyun-kur",
 "title_tr": "GTA benzeri 2D şehir oyunu kurulum akışı",
 "principle": "Kod karar verir, model açıklar, usta onaylar. Model oyunu bu akışla BİR KEZ kurar; oyun index.html içinde kendi başına döner (gerçek zamanlı döngü tarayıcıda, modelde değil).",
 "skill_independent": "Bu dosya hangi becerinin hangi sırayla, hangi girdiyle çağrılacağını ve her adımdan sonra neyin kontrol edileceğini tanımlar. Adımlar beceri kimliğiyle (G001-G012) ve sözleşmeyle (girdi/çıktı alanları) bağlanır; aynı sözleşmeyi sağlayan başka bir beceri takılabilir.",
 "resolvers": {
  "$var": "variables içinden değer",
  "$ref": "önceki adımın çıktısından nokta yolu (adim.result.alan.0)",
  "$tile_center_x / $tile_center_y": "karo [x,y] -> merkez x+0.5 / y+0.5",
  "$pluck": "{from, field}: listedeki ya da sözlükteki her öğeden bir alan",
  "$concat": "listeleri uç uca ekle",
  "$range": "{start, step, count}: sayı dizisi"
 },
 "variables": {
  "title": "Mini Şehir",
  "seed": 2026,
  "width": 40,
  "height": 30,
  "timestep_ms": 16.6667,
  "dt_s": 0.0166667,
  "start_money": 200,
  "cash_amount": 50,
  "vehicle": {
   "wheelbase_m": 0.9,
   "max_steer_deg": 35,
   "accel": 7.0,
   "brake": 12.0,
   "reverse_accel": 4.0,
   "drag": 0.25,
   "max_v": 11.0,
   "min_v": -4.0,
   "offroad_factor": 0.55,
   "radius": 0.38
  },
  "npc": {
   "ped_max_speed": 1.1,
   "ped_max_force": 6.0,
   "traffic_max_speed": 3.5,
   "traffic_max_force": 8.0,
   "police_max_speed": 10.0,
   "police_max_force": 30.0,
   "flee_panic_distance": 3.0,
   "arrive_deceleration": 2.0,
   "prediction_factor": 1.0
  }
 },
