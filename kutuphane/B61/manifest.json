{
  "id": "B61",
  "name": "psutil read-only snapshot arithmetic",
  "description": "Calculation contract port for explicit sampled counters; not a live psutil binding. Disk denominator is total capacity, not psutil reserved-space-adjusted user percentage. No process control or performance diagnosis.",
  "version": "0.1.0",
  "date": "2026-11-11",
  "tier": "general",
  "source_url": "https://github.com/giampaolo/psutil",
  "upstream_commit_or_version": "42a7b5963698393a37cbde60d5aac3c63f56bb03",
  "license": "BSD-3-Clause",
  "distribution": "public-ok",
  "attribution": [
    "giampaolo/psutil",
    "Original copyright and notices preserved in LICENSE, NOTICE and upstream/"
  ],
  "inputs": {
    "type": "object",
    "properties": {
      "memory_total": {
        "type": "number",
        "minimum": 1
      },
      "memory_available": {
        "type": "number",
        "minimum": 0
      },
      "disk_total": {
        "type": "number",
        "minimum": 1
      },
      "disk_free": {
        "type": "number",
        "minimum": 0
      },
      "cpu_busy_delta": {
        "type": "number",
        "minimum": 0
      },
      "cpu_total_delta": {
        "type": "number",
        "minimum": 1e-09
      }
    },
    "required": [
      "memory_total",
      "memory_available",
      "disk_total",
      "disk_free",
      "cpu_busy_delta",
      "cpu_total_delta"
    ],
    "additionalProperties": false
  },
  "outputs": {
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "ok": {
            "const": true
          },
          "result": {
            "type": "object",
            "properties": {
              "cpu_percent": {
                "type": "number"
              },
              "disk_used_percent": {
                "type": "number"
              },
              "memory_used_percent": {
                "type": "number"
              }
            },
            "required": [
              "cpu_percent",
              "disk_used_percent",
              "memory_used_percent"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "ok",
          "result"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "ok": {
            "const": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "maxLength": 100000
              },
              "message": {
                "type": "string",
                "maxLength": 100000
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "ok",
          "error"
        ],
        "additionalProperties": false
      }
    ]
  },
  "budget": {
    "max_input_bytes": 1048576,
    "timeout_seconds": 10,
    "max_array_items": 10000,
    "enforcement": "CLI input byte bound and JSON Schema array/string bounds enforced. Runtime timeout is enforced for subprocess tools only; other tools require an external 10-second watchdog. No general memory sandbox claimed."
  },
  "signature": null,
  "revocation_url": null,
  "teaching_path": [
    "Inspect SOURCE.md and license evidence",
    "Call the deterministic JSON tool",
    "Review tests and explain the returned result; never invent missing values"
  ],
  "status": "built",
  "skip_reason": null,
  "implementation_kind": "ported-core",
  "tool": "tool/main.py",
  "dependencies": {
    "python": ">=3.11",
    "shared_runtime": "../_vendor",
    "node": ">=20 for JS-backed tools"
  },
  "mcp": {
    "transport": "stdio",
    "command": "python3",
    "tool_name": "skillpack_b61",
    "server_path": "mcp/server.py"
  }
}
