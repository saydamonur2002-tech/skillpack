{
  "id": "G010",
  "name": "Save and load game state (versioned JSON envelope with FNV-1a checksum)",
  "description": "Saves the city game state (player car, money, inventory, wanted level, missions, picked-up cash) as a versioned envelope with a canonical JSON form (sorted keys, numbers rounded to 3 decimals) and an FNV-1a 32-bit checksum, and loads it back, refusing saves of another format or version and reporting damaged or edited saves. The browser game writes the same envelope to localStorage.",
  "version": "1.0.0",
  "date": "2026-11-12",
  "tier": "game",
  "family": "game-2d-city",
  "category": "game persistence",
  "license": "MIT",
  "distribution": "public-ok",
  "author": "Skillpack contributors",
  "source_url": "local:original/G010",
  "upstream_commit_or_version": "original-1.0.0",
  "implementation_kind": "original-algorithm",
  "status": "tested-awaiting-usta-approval",
  "provenance": {
    "upstream_repository": null,
    "source_kind": "original",
    "commit": "original-1.0.0",
    "version": "1.0.0",
    "license_spdx": "MIT",
    "license_path": "LICENSE",
