{
  "id": "A50",
  "name": "Cast V2 bounded length-prefix decoder",
  "description": "One complete frame only. Protocol buffers and device control excluded. Hardened length and truncation checks.",
  "version": "0.1.0",
  "date": "2026-11-11",
  "tier": "revival",
  "source_url": "https://github.com/ninjasphere/go-castv2/blob/master/PacketStream.go",
  "upstream_commit_or_version": "c628dcf318eee67f396e13d6a8ec53d2925c93e3",
  "license": "MIT",
  "distribution": "public-ok",
  "attribution": [
    "ninjasphere/go-castv2",
    "Original copyright and notices preserved in LICENSE, NOTICE and upstream/"
  ],
  "inputs": {
    "type": "object",
    "properties": {
      "hex": {
        "type": "string",
        "maxLength": 100000
      },
      "max_len": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1048576
      }
    },
    "required": [
      "hex"
    ],
    "additionalProperties": false
  },
  "outputs": {
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "ok": {
            "const": true
          },
          "result": {
            "type": "object",
            "properties": {
              "length": {
                "type": "number"
              },
              "payload_hex": {
                "type": "string"
              }
            },
            "required": [
              "length",
              "payload_hex"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "ok",
          "result"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "ok": {
            "const": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "maxLength": 100000
              },
              "message": {
                "type": "string",
                "maxLength": 100000
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "ok",
          "error"
        ],
        "additionalProperties": false
      }
    ]
  },
  "budget": {
    "max_input_bytes": 1048576,
    "timeout_seconds": 10,
    "max_array_items": 10000,
    "enforcement": "CLI input byte bound and JSON Schema array/string bounds enforced. Runtime timeout is enforced for subprocess tools only; other tools require an external 10-second watchdog. No general memory sandbox claimed."
  },
  "signature": null,
  "revocation_url": null,
  "teaching_path": [
    "Inspect SOURCE.md and license evidence",
    "Call the deterministic JSON tool",
    "Review tests and explain the returned result; never invent missing values"
  ],
  "status": "built",
  "skip_reason": null,
  "implementation_kind": "ported-core",
  "tool": "tool/main.py",
  "dependencies": {
    "python": ">=3.11",
    "shared_runtime": "../_vendor",
    "node": ">=20 for JS-backed tools"
  },
  "mcp": {
    "transport": "stdio",
    "command": "python3",
    "tool_name": "skillpack_a50",
    "server_path": "mcp/server.py"
  }
}
