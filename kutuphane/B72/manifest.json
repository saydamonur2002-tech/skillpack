{
  "id": "B72",
  "name": "AsyncAPI fixed sensor payload contract",
  "description": "New example payload schema following the AsyncAPI message payload concept; not an AsyncAPI document validator, broker, MQTT permission check or authentication.",
  "version": "0.1.0",
  "date": "2026-11-11",
  "tier": "general",
  "source_url": "https://github.com/asyncapi/spec",
  "upstream_commit_or_version": "41662743fe64189858f4076f27d2b1d9da6b3093",
  "license": "Apache-2.0",
  "distribution": "public-ok",
  "attribution": [
    "asyncapi/spec",
    "Original copyright and notices preserved in LICENSE, NOTICE and upstream/"
  ],
  "inputs": {
    "type": "object",
    "properties": {
      "message": {
        "type": "object"
      }
    },
    "required": [
      "message"
    ],
    "additionalProperties": false
  },
  "outputs": {
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "ok": {
            "const": true
          },
          "result": {
            "type": "object",
            "properties": {
              "valid": {
                "type": "boolean"
              }
            },
            "required": [
              "valid"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "ok",
          "result"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "ok": {
            "const": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "maxLength": 100000
              },
              "message": {
                "type": "string",
                "maxLength": 100000
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "ok",
          "error"
        ],
        "additionalProperties": false
      }
    ]
  },
  "budget": {
    "max_input_bytes": 1048576,
    "timeout_seconds": 10,
    "max_array_items": 10000,
    "enforcement": "CLI input byte bound and JSON Schema array/string bounds enforced. Runtime timeout is enforced for subprocess tools only; other tools require an external 10-second watchdog. No general memory sandbox claimed."
  },
  "signature": null,
  "revocation_url": null,
  "teaching_path": [
    "Inspect SOURCE.md and license evidence",
    "Call the deterministic JSON tool",
    "Review tests and explain the returned result; never invent missing values"
  ],
  "status": "built",
  "skip_reason": null,
  "implementation_kind": "schema-rule",
  "tool": "tool/main.py",
  "dependencies": {
    "python": ">=3.11",
    "shared_runtime": "../_vendor",
    "node": ">=20 for JS-backed tools"
  },
  "mcp": {
    "transport": "stdio",
    "command": "python3",
    "tool_name": "skillpack_b72",
    "server_path": "mcp/server.py"
  }
}
